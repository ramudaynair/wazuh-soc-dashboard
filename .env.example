# Wazuh Monitor — Environment Variables
# Copy this file to .env and fill in your actual values
# ⚠️  Never commit .env — it is excluded by .gitignore

# Wazuh Manager API (port 55000)
WAZUH_HOST=https://your-wazuh-manager:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=your-manager-password-here
VERIFY_SSL=false

# Wazuh Indexer / OpenSearch (port 9200) — required for vulnerability data
# In Wazuh 4.x, vulnerability state is stored in the Indexer, not the Manager API.
# Extract password: sudo tar -O -xf /var/ossec/wazuh-install-files.tar wazuh-install-files/wazuh-passwords.txt
WAZUH_INDEXER_HOST=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=your-indexer-password-here
